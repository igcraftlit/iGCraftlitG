{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "electrobun": [
        "./.hutch/devkit/api/sdks/main/index.ts",
        "../shell/.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun/main": [
        "./.hutch/devkit/api/sdks/main/index.ts",
        "../shell/.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun/*": [
        "./.hutch/devkit/api/sdks/main/*",
        "../shell/.hutch/devkit/api/sdks/main/*"
      ]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "electrobun.config.ts"]
}