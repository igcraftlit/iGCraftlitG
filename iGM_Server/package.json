{
  "name": "igcraftlit-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/iGM_ServerMain.ts",
    "start": "bun run src/iGM_ServerMain.ts",
    "db:init": "bun run src/iGM_Database/iGM_DbCli.ts init",
    "db:migrate": "bun run src/iGM_Database/iGM_DbCli.ts migrate",
    "db:seed": "bun run src/iGM_Database/iGM_DbCli.ts seed",
    "db:relations": "bun run src/iGM_Database/iGM_DbCli.ts relations"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@xenova/transformers": "^2.17.2",
    "elysia": "1.4.30",
    "mammoth": "^1.13.0",
    "nodemailer": "^10.0.10",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.23.1",
    "turndown": "^7.2.4",
    "word-extractor": "^1.0.4"
  },
  "devDependencies": {
    "@types/bun": "1.3.11",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/turndown": "^5.0.6",
    "typescript": "5.9.2"
  }
}
